# --- Monitoring the source Telegram channel ---
# Create these at https://my.telegram.org/apps
TG_API_ID=123456
TG_API_HASH=your_telegram_api_hash

# Source channel to watch, for example @gubernator_xx
SOURCE_CHANNEL=@source_channel

# --- Publishing to your Telegram channel ---
# Bot token from @BotFather
TG_BOT_TOKEN=1234567890:your_telegram_bot_token

# Target Telegram channel, for example @my_channel or -1001234567890
TG_TARGET_CHANNEL=@target_channel

# --- Publishing to your MAX channel ---
# Bot token from @MasterBot in MAX
MAX_BOT_TOKEN=your_max_bot_token

# MAX channel chat id. Use max_get_chat_id.py to find it.
MAX_CHAT_ID=your_max_chat_id

# --- AI rewrite via AITunnel ---
AITUNNEL_API_KEY=your_aitunnel_api_key
AITUNNEL_MODEL=gpt-4o-mini
