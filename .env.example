# Шаблон настроек. Скопируйте в .env и подставьте реальные значения:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# Файл .env в репозиторий не попадает (см. .gitignore).

# --- Обязательное -----------------------------------------------------------

# Токен бота MAX (получить у @masterbot). Бот должен быть подписан на канал-
# источник и быть администратором целевого канала.
MAX_TOKEN=your_max_bot_token

# Ключ aitunnel.ru для рерайта постов о БПЛА.
AI_API_KEY=your_aitunnel_api_key

# --- Необязательное (значения по умолчанию — в config.py) -------------------

# Канал-источник и целевой канал (chat_id можно узнать: python bot.py --chats).
#MAX_SOURCE_CHAT_ID=-68128408750804
#MAX_TARGET_CHAT_ID=-68432827435555

# Модель рерайта на aitunnel.ru.
#AI_MODEL=gpt-5.6-luna

# Интервал опроса источника, секунды.
#MAX_POLL_INTERVAL_SEC=45

# Браковать рерайт, потерявший числа исходника (1 — да, 0 — только лог).
#AI_REQUIRE_ALL_NUMBERS=1

# Выключить рерайт целиком (посты о БПЛА пойдут исходным текстом).
#AI_ENABLED=0
